/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attendance {
  id                String           @id @db.VarChar
  legislator_id     String           @db.VarChar
  date              DateTime         @db.Timestamptz(6)
  session_type      sessiontype
  created_at        DateTime         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at        DateTime         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  attendance_status attendancestatus
  notes             String?          @db.VarChar(500)
  legislator        legislator       @relation(fields: [legislator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([attendance_status], map: "ix_attendance_attendance_status")
  @@index([legislator_id], map: "ix_attendance_legislator_id")
  @@index([session_type], map: "ix_attendance_session_type")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bill {
  id                     String              @id @db.VarChar
  number                 String              @unique @db.VarChar(50)
  title                  String?
  summary                String?
  submission_date        DateTime            @db.Timestamptz(6)
  created_at             DateTime            @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at             DateTime            @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  parliamentary_group_id String?             @db.VarChar
  approval_date          DateTime?           @db.Timestamptz(6)
  approval_status        billapprovalstatus  @default(PRESENTADO)
  sponsor                String?             @db.VarChar(150)
  period                 String?             @db.VarChar(50)
  legislative_session    String?             @db.VarChar(100)
  committees             String?
  document_url           String?             @db.VarChar
  title_ai               String?
  legislator_id          String              @db.VarChar
  coauthors              String?
  cosponsors             String?
  legislator             legislator          @relation(fields: [legislator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parliamentarygroup     parliamentarygroup? @relation(fields: [parliamentary_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approval_date], map: "ix_bill_approval_date")
  @@index([approval_status], map: "ix_bill_approval_status")
  @@index([legislator_id], map: "ix_bill_legislator_id")
  @@index([parliamentary_group_id], map: "ix_bill_parliamentary_group_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model electoralprocess {
  id                  String                @id @db.VarChar
  name                String                @db.VarChar(200)
  year                Int
  election_date       DateTime              @db.Timestamptz(6)
  active              Boolean
  created_at          DateTime              @db.Timestamptz(6)
  updated_at          DateTime              @db.Timestamptz(6)
  alliancecomposition alliancecomposition[]
  candidate           candidate[]

  @@index([year], map: "ix_electoralprocess_year")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model executive {
  id                    String             @id @db.VarChar
  person_id             String             @db.VarChar
  role                  executiverole
  start_date            DateTime           @db.Timestamptz(6)
  end_date              DateTime?          @db.Timestamptz(6)
  end_reason            endoftermreason?
  created_at            DateTime           @db.Timestamptz(6)
  updated_at            DateTime           @db.Timestamptz(6)
  ministry              String?            @db.VarChar
  active                Boolean            @default(true)
  legislative_period_id String?            @db.VarChar
  person                person             @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legislativeperiod     legislativeperiod? @relation(fields: [legislative_period_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([person_id], map: "ix_executive_person_id")
  @@index([legislative_period_id], map: "ix_executive_period_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model legislativeperiod {
  id                String              @id @db.VarChar
  name              String              @db.VarChar(200)
  start_date        DateTime            @db.Date
  end_date          DateTime            @db.Date
  active            Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  seatparliamentary seatparliamentary[]
  legislator        legislator[]
  executive         executive[]

  @@index([active])
}

model seatparliamentary {
  id                     String              @id @db.VarChar
  chamber                chambertype
  number_seat            Int
  row                    Int
  legislator_id          String?             @db.VarChar
  parliamentary_group_id String?             @db.VarChar
  legislative_period_id  String?             @db.VarChar
  created_at             DateTime            @db.Timestamptz(6)
  updated_at             DateTime            @db.Timestamptz(6)
  legislator             legislator?         @relation(fields: [legislator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parliamentarygroup     parliamentarygroup? @relation(fields: [parliamentary_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legislativeperiod      legislativeperiod?  @relation(fields: [legislative_period_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([legislator_id], map: "ix_seatparliamentary_legislator_id")
  @@index([parliamentary_group_id], map: "ix_seatparliamentary_group_id")
  @@index([legislative_period_id], map: "ix_seatparliamentary_period_id")
}

enum attendancestatus {
  ASISTENCIA
  FALTA
  FALTA_JUSTIFICADA
  TARDANZA
  LICENCIA
  COMISION_OFICIAL
}

enum billapprovalstatus {
  PRESENTADO
  EN_COMISION
  DICTAMEN
  EN_AGENDA_PLENO
  ORDEN_DEL_DIA
  EN_CUARTO_INTERMEDIO
  APROBADO_PRIMERA_VOTACION
  PENDIENTE_SEGUNDA_VOTACION
  APROBADO
  AUTOGRAFA
  PUBLICADO
  EN_RECONSIDERACION
  RETORNA_A_COMISION
  AL_ARCHIVO
  DECRETO_ARCHIVO
  RETIRADO_POR_AUTOR
}

enum chambertype {
  CONGRESO
  SENADO
  DIPUTADOS
}

enum endoftermreason {
  RENUNCIA
  REMOCION
  FALLECIMIENTO
  VACANCIA
  PERIODO_FINALIZADO
  DESCONOCIDO
}

enum executiverole {
  PRESIDENTE
  VICEPRESIDENTE
  PRIMER_MINISTRO
  MINISTRO
}

enum sessiontype {
  PLENO
  COMISION_PERMANENTE
  COMISION_ORDINARIA
  EXTRAORDINARIA
}
