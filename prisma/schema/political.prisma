/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alliancecomposition {
  id               String            @id(map: "alliance_composition_pkey") @db.VarChar
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  parent_org_id    String?           @db.VarChar
  child_org_id     String?           @db.VarChar
  process_id       String?           @db.VarChar
  parentParty      politicalparty?   @relation("AllianceParent", fields: [parent_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "alliance_composition_parent_org_id_fkey")
  childParty       politicalparty?   @relation("AllianceChild", fields: [child_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "alliance_composition_child_org_id_fkey")
  electoralprocess electoralprocess? @relation(fields: [process_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "alliance_composition_process_id_fkey")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model candidate {
  id                    String            @id @db.VarChar
  person_id             String            @db.VarChar
  electoral_process_id  String            @db.VarChar
  type                  candidacytype
  political_party_id    String            @db.VarChar
  electoral_district_id String
  status                candidacystatus
  created_at            DateTime          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  list_number           Int?
  updated_at            DateTime          @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  active                Boolean
  electoraldistrict     electoraldistrict @relation(fields: [electoral_district_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  electoralprocess      electoralprocess  @relation(fields: [electoral_process_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person                person            @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  politicalparty        politicalparty    @relation(fields: [political_party_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidatemetrics      candidatemetrics?

  @@index([electoral_district_id], map: "idx_candidate_district")
  @@index([political_party_id], map: "idx_candidate_party")
  @@index([electoral_process_id, type, active], map: "idx_candidate_process_type_active")
  @@index([electoral_process_id], map: "ix_candidate_electoral_process_id")
  @@index([person_id], map: "ix_candidate_person_id")
  @@index([political_party_id], map: "ix_candidate_political_party_id")
  @@index([type], map: "ix_candidate_type")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model candidatemetrics {
  candidate_id               String    @id @db.VarChar
  total_previous_candidacies Int
  times_elected              Int
  political_experience_years Int
  total_parties_belonged     Int
  years_in_current_party     Float
  max_academic_level_score   Int
  has_postgraduate           Boolean
  declared_income_annual     Float
  declared_assets_value      Float
  total_legal_records        Int
  has_penal_sentences        Boolean
  has_alimentary_debts       Boolean
  last_updated               DateTime  @db.Timestamp(6)
  candidate                  candidate @relation(fields: [candidate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model financingreports {
  id             String           @id @db.VarChar
  party_id       String           @db.VarChar
  report_name    String           @db.VarChar
  filing_status  financingstatus
  source_name    String           @db.VarChar
  source_url     String?          @db.VarChar
  report_date    DateTime         @db.Date
  period_start   DateTime         @db.Date
  period_end     DateTime         @db.Date
  created_at     DateTime         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at     DateTime         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  politicalparty politicalparty   @relation(fields: [party_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
