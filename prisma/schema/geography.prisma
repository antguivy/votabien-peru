/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model electoraldistrict {
  id             String              @id @db.VarChar
  name           String              @db.VarChar(100)
  code           String              @unique @db.VarChar(10)
  is_national    Boolean
  created_at     DateTime            @db.Timestamptz(6)
  active         Boolean
  updated_at     DateTime            @db.Timestamptz(6)
  ubigeo         String?
  level          districtlevel       @default(NACIONAL)
  parent_id      String?             @db.VarChar
  parent         electoraldistrict?  @relation("DistrictHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       electoraldistrict[] @relation("DistrictHierarchy")
  candidate      candidate[]
  legislator     legislator[]
  politicalparty politicalparty[]

  @@unique([name, parent_id], map: "ix_electoraldistrict_name_parent")
}

enum districtlevel {
  NACIONAL
  REGIONAL
  PROVINCIAL
  DISTRITAL
}
