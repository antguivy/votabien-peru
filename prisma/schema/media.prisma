model press_source {
  id                   String             @id @default(cuid()) @db.VarChar
  name                 String             @db.VarChar(100)
  domain               String             @unique @db.VarChar(100)
  scope                mediascope         @default(REGIONAL)
  electoraldistrict_id String?            @db.VarChar
  active               Boolean            @default(true)
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  electoraldistrict    electoraldistrict? @relation(fields: [electoraldistrict_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([scope])
  @@index([electoraldistrict_id])
  @@index([active])
}

enum mediascope {
  NACIONAL
  REGIONAL
  LOCAL
}
