/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model background {
  id               String           @id @db.VarChar
  person_id        String           @db.VarChar
  publication_date String?
  type             backgroundtype
  status           backgroundstatus
  summary          String?
  sanction         String?          @db.VarChar(500)
  source           String           @db.VarChar(300)
  source_url       String?          @db.VarChar
  created_at       DateTime         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at       DateTime         @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  title            String
  person           person           @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([person_id], map: "ix_background_person_id")
  @@index([status], map: "ix_background_status")
  @@index([type], map: "ix_background_type")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model person {
  id                       String              @id @db.VarChar
  name                     String              @db.VarChar(150)
  lastname                 String              @db.VarChar(150)
  fullname                 String              @unique(map: "ix_person_fullname") @db.VarChar(300)
  image_url                String?             @db.VarChar
  birth_date               DateTime?           @db.Timestamptz(6)
  profession               String?             @db.VarChar(200)
  detailed_biography       Json?
  technical_education      Json?
  university_education     Json                @default("[]")
  no_university_education  Json?
  postgraduate_education   Json                @default("[]")
  work_experience          Json                @default("[]")
  facebook_url             String?             @db.VarChar
  twitter_url              String?             @db.VarChar
  instagram_url            String?             @db.VarChar
  tiktok_url               String?             @db.VarChar
  created_at               DateTime            @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  updated_at               DateTime            @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  secondary_school         Boolean?
  political_role           Json?
  popular_election         Json?
  incomes                  Json?
  assets                   Json?
  dni                      String?             @unique
  gender                   String?
  party_number_rop         String?
  place_of_birth           String?
  image_candidate_url      String?
  education_level          Int                 @default(1) @db.SmallInt
  is_incumbent             Boolean?
  has_criminal_record      Boolean             @default(false)
  has_penal_sentence       Boolean             @default(false)
  has_sanction             Boolean             @default(false)
  is_under_investigation   Boolean             @default(false)
  reinfo_status            String?
  rnas_sanctions           Json[]              @default([])
  has_income               Boolean             @default(false)
  has_assets               Boolean             @default(false)
  has_electoral_experience Boolean             @default(false)
  work_experience_count    Int                 @default(0)
  background               background[]
  candidate                candidate[]
  executive                executive[]
  legislator               legislator[]
  person_embeddings        person_embeddings[]
  triviagame               triviagame[]

  @@index([dni(ops: raw("gin_trgm_ops"))], map: "idx_person_dni_trgm", type: Gin)
  @@index([fullname(ops: raw("gin_trgm_ops"))], map: "idx_person_fullname_trgm", type: Gin)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model person_embeddings {
  id         BigInt                 @id @default(autoincrement())
  person_id  String
  content    String
  chunk_type String
  embedding  Unsupported("vector")?
  metadata   Json?                  @default("{}")
  created_at DateTime?              @default(now()) @db.Timestamptz(6)
  person     person                 @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chunk_type])
  @@index([chunk_type], map: "person_embeddings_chunk_type_idx1")
  @@index([chunk_type], map: "person_embeddings_chunk_type_idx2")
  @@index([chunk_type], map: "person_embeddings_chunk_type_idx3")
  @@index([chunk_type], map: "person_embeddings_chunk_type_idx4")
  @@index([chunk_type], map: "person_embeddings_chunk_type_idx5")
  @@index([chunk_type], map: "person_embeddings_chunk_type_idx6")
  @@index([chunk_type], map: "person_embeddings_chunk_type_idx7")
  @@index([embedding])
  @@index([embedding], map: "person_embeddings_embedding_idx1")
  @@index([embedding], map: "person_embeddings_embedding_idx2")
  @@index([embedding], map: "person_embeddings_embedding_idx3")
  @@index([embedding], map: "person_embeddings_embedding_idx4")
  @@index([embedding], map: "person_embeddings_embedding_idx5")
  @@index([embedding], map: "person_embeddings_embedding_idx6")
  @@index([embedding], map: "person_embeddings_embedding_idx7")
  @@index([person_id])
  @@index([person_id], map: "person_embeddings_person_id_idx1")
  @@index([person_id], map: "person_embeddings_person_id_idx2")
  @@index([person_id], map: "person_embeddings_person_id_idx3")
  @@index([person_id], map: "person_embeddings_person_id_idx4")
  @@index([person_id], map: "person_embeddings_person_id_idx5")
  @@index([person_id], map: "person_embeddings_person_id_idx6")
  @@index([person_id], map: "person_embeddings_person_id_idx7")
}

enum backgroundstatus {
  EN_INVESTIGACION
  SENTENCIADO
  SANCIONADO
  ARCHIVADO
  ABSUELTO
  PRESCRITO
}

enum backgroundtype {
  PENAL
  ETICA
  CIVIL
  ADMINISTRATIVO
}
